---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAllProducts } from '../../../lib/products';

// Note: SSR auth check won't work with localStorage
// We use client-side check below

const products = await getAllProducts();
---

<AdminLayout title="Kelola Produk | Admin AZKA MEUBEL">
  <!-- Auth check script -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script is:inline define:vars={{ supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL, supabaseKey: import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY }}>
    (async () => {
      const { createClient } = supabase;
      const supabaseClient = createClient(supabaseUrl, supabaseKey);
      
      const { data: { session } } = await supabaseClient.auth.getSession();
      
      if (!session) {
        window.location.href = '/admin/login';
        return;
      }

      // Check admin role
      const { data: profile, error: profileError } = await supabaseClient
        .from('profiles')
        .select('role')
        .eq('id', session.user.id)
        .maybeSingle();

      if (profileError || !profile || profile.role !== 'admin') {
        await supabaseClient.auth.signOut();
        window.location.href = '/admin/login';
      }
    })();
  </script>

  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="font-headline-lg text-on-surface mb-2">Kelola Produk</h1>
        <p class="font-body-md text-on-surface-variant">
          {products.length} produk total
        </p>
      </div>
      <a
        href="/admin/products/new"
        class="inline-flex items-center gap-2 bg-primary text-on-primary px-6 py-3 font-label-md uppercase hover:bg-secondary transition-colors"
      >
        <span class="material-symbols-outlined text-[18px]">add</span>
        <span>Tambah Produk</span>
      </a>
    </div>

    {products.length > 0 ? (
      <div class="bg-background border border-surface-container-highest overflow-hidden">
        <table class="w-full">
          <thead class="bg-surface-container-low">
            <tr>
              <th class="text-left px-6 py-3 font-label-sm uppercase text-on-surface-variant">
                Produk
              </th>
              <th class="text-left px-6 py-3 font-label-sm uppercase text-on-surface-variant">
                ID Produk
              </th>
              <th class="text-left px-6 py-3 font-label-sm uppercase text-on-surface-variant">
                Kategori
              </th>
              <th class="text-left px-6 py-3 font-label-sm uppercase text-on-surface-variant">
                Harga
              </th>
              <th class="text-left px-6 py-3 font-label-sm uppercase text-on-surface-variant">
                Status
              </th>
              <th class="text-right px-6 py-3 font-label-sm uppercase text-on-surface-variant">
                Aksi
              </th>
            </tr>
          </thead>
          <tbody>
            {products.map((product) => (
              <tr class="border-t border-surface-container-highest hover:bg-surface-container-low transition-colors">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <img
                      src={product.main_image}
                      alt={product.name}
                      class="w-16 h-16 object-cover bg-surface-container"
                      loading="lazy"
                    />
                    <div>
                      <p class="font-body-md text-on-surface font-medium">
                        {product.name}
                      </p>
                      <p class="font-body-sm text-on-surface-variant">
                        {product.slug}
                      </p>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 font-body-sm text-on-surface-variant font-mono">
                  {product.product_code}
                </td>
                <td class="px-6 py-4 font-body-sm text-on-surface-variant">
                  {product.category?.name || '-'}
                </td>
                <td class="px-6 py-4 font-body-sm text-on-surface">
                  {product.show_price && product.price
                    ? `Rp ${product.price.toLocaleString('id-ID')}`
                    : '-'}
                </td>
                <td class="px-6 py-4">
                  <span class={`inline-block px-3 py-1 font-label-sm uppercase ${
                    product.status === 'published'
                      ? 'bg-secondary text-on-secondary'
                      : 'bg-surface-container text-on-surface-variant'
                  }`}>
                    {product.status === 'published' ? 'Published' : 'Draft'}
                  </span>
                </td>
                <td class="px-6 py-4">
                  <div class="flex items-center justify-end gap-2">
                    <a
                      href={`/products/${product.slug}`}
                      class="p-2 text-on-surface hover:text-primary transition-colors"
                      title="Lihat"
                      target="_blank"
                    >
                      <span class="material-symbols-outlined text-[20px]">visibility</span>
                    </a>
                    <a
                      href={`/admin/products/${product.id}/edit`}
                      class="p-2 text-on-surface hover:text-primary transition-colors"
                      title="Edit"
                    >
                      <span class="material-symbols-outlined text-[20px]">edit</span>
                    </a>
                    <button
                      class="delete-btn p-2 text-on-surface hover:text-error transition-colors"
                      data-id={product.id}
                      data-name={product.name}
                      title="Hapus"
                    >
                      <span class="material-symbols-outlined text-[20px]">delete</span>
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="bg-background border border-surface-container-highest p-16 text-center">
        <span class="material-symbols-outlined text-[64px] text-on-surface-variant mb-4 block">
          inventory_2
        </span>
        <h3 class="font-headline-sm text-on-surface mb-2">Belum ada produk</h3>
        <p class="font-body-md text-on-surface-variant mb-6">
          Mulai tambahkan produk pertama Anda
        </p>
        <a
          href="/admin/products/new"
          class="inline-flex items-center gap-2 bg-primary text-on-primary px-6 py-3 font-label-md uppercase hover:bg-secondary transition-colors"
        >
          <span class="material-symbols-outlined text-[18px]">add</span>
          <span>Tambah Produk</span>
        </a>
      </div>
    )}
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="delete-modal" class="hidden fixed inset-0 bg-primary/50 flex items-center justify-center z-50">
    <div class="bg-background border border-surface-container-highest p-8 max-w-md w-full mx-4">
      <h3 class="font-headline-sm text-on-surface mb-4">Hapus Produk?</h3>
      <p class="font-body-md text-on-surface-variant mb-6">
        Apakah Anda yakin ingin menghapus produk "<span id="delete-product-name"></span>"?
        Tindakan ini tidak dapat dibatalkan.
      </p>
      <div class="flex gap-4">
        <button
          id="cancel-delete"
          class="flex-1 border border-outline px-6 py-3 font-label-md uppercase text-on-surface hover:bg-surface-container transition-colors"
        >
          Batal
        </button>
        <button
          id="confirm-delete"
          class="flex-1 bg-error text-on-error px-6 py-3 font-label-md uppercase hover:opacity-90 transition-opacity"
        >
          Hapus
        </button>
      </div>
    </div>
  </div>

  <script>
    import { deleteProduct } from '../../../lib/products';

    const deleteButtons = document.querySelectorAll('.delete-btn');
    const modal = document.getElementById('delete-modal');
    const productNameSpan = document.getElementById('delete-product-name');
    const cancelBtn = document.getElementById('cancel-delete');
    const confirmBtn = document.getElementById('confirm-delete');
    let currentDeleteId: string | null = null;

    deleteButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name');
        
        if (id && name && productNameSpan && modal) {
          currentDeleteId = id;
          productNameSpan.textContent = name;
          modal.classList.remove('hidden');
        }
      });
    });

    cancelBtn?.addEventListener('click', () => {
      modal?.classList.add('hidden');
      currentDeleteId = null;
    });

    confirmBtn?.addEventListener('click', async () => {
      if (!currentDeleteId) return;

      try {
        await deleteProduct(currentDeleteId);
        window.location.reload();
      } catch (error) {
        console.error('Delete error:', error);
        alert('Gagal menghapus produk. Silakan coba lagi.');
      }
    });
  </script>
</AdminLayout>
