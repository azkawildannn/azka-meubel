---
import AdminLayout from '../../../layouts/AdminLayout.astro';

// Note: SSR auth check won't work with localStorage
// We use client-side check in the layout/script below

// Get categories
const { supabase } = await import('../../../lib/supabase');
const { data: categories } = await supabase
  .from('categories')
  .select('*')
  .eq('is_active', true)
  .order('name');
---

<AdminLayout title="Tambah Produk | Admin AZKA MEUBEL">
  <!-- Auth check script (same as dashboard) -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script is:inline define:vars={{ supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL, supabaseKey: import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY }}>
    (async () => {
      const { createClient } = supabase;
      const supabaseClient = createClient(supabaseUrl, supabaseKey);
      
      const { data: { session } } = await supabaseClient.auth.getSession();
      
      if (!session) {
        console.log('No session, redirecting to login');
        window.location.href = '/admin/login';
        return;
      }

      // Check admin role
      const { data: profile, error: profileError } = await supabaseClient
        .from('profiles')
        .select('role')
        .eq('id', session.user.id)
        .maybeSingle();

      if (profileError || !profile || profile.role !== 'admin') {
        console.warn('Not admin, redirecting');
        await supabaseClient.auth.signOut();
        window.location.href = '/admin/login';
      }
    })();
  </script>

  <div class="max-w-4xl">
    <div class="mb-8">
      <a
        href="/admin/products"
        class="inline-flex items-center gap-2 font-label-sm uppercase text-on-surface-variant hover:text-primary transition-colors mb-4"
      >
        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
        <span>Kembali ke List Produk</span>
      </a>
      <h1 class="font-headline-lg text-on-surface mb-2">Tambah Produk Baru</h1>
      <p class="font-body-md text-on-surface-variant">
        Lengkapi form di bawah untuk menambahkan produk baru
      </p>
    </div>

    <div class="bg-background border border-surface-container-highest p-8">
      <form id="product-form" method="POST" action="#" class="space-y-8">
        <!-- Basic Info -->
        <div class="space-y-6">
          <h2 class="font-headline-sm text-on-surface pb-2 border-b border-surface-container-highest">
            Informasi Dasar
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="name" class="font-label-sm uppercase text-on-surface block">
                Nama Produk <span class="text-error">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full bg-surface-container-low px-4 py-3 font-body-md text-on-surface focus:outline-none focus:bg-background transition-colors border border-transparent focus:border-primary"
                placeholder="Contoh: Kursi Makan Minimalis"
              />
            </div>

            <div class="space-y-2">
              <label for="product_code" class="font-label-sm uppercase text-on-surface block">
                ID Produk <span class="text-error">*</span>
              </label>
              <input
                type="text"
                id="product_code"
                name="product_code"
                required
                class="w-full bg-surface-container-low px-4 py-3 font-body-md text-on-surface focus:outline-none focus:bg-background transition-colors border border-transparent focus:border-primary"
                placeholder="Contoh: AZK-CHR-001"
              />
              <p class="font-body-sm text-on-surface-variant">Harus unik</p>
            </div>

            <div class="space-y-2">
              <label for="slug" class="font-label-sm uppercase text-on-surface block">
                URL Slug <span class="text-error">*</span>
              </label>
              <input
                type="text"
                id="slug"
                name="slug"
                required
                class="w-full bg-surface-container-low px-4 py-3 font-body-md text-on-surface focus:outline-none focus:bg-background transition-colors border border-transparent focus:border-primary"
                placeholder="kursi-makan-minimalis"
              />
              <p class="font-body-sm text-on-surface-variant">Auto-generate dari nama (lowercase, gunakan -)</p>
            </div>

            <div class="space-y-2">
              <label for="category_id" class="font-label-sm uppercase text-on-surface block">
                Kategori <span class="text-error">*</span>
              </label>
              <select
                id="category_id"
                name="category_id"
                required
                class="w-full bg-surface-container-low px-4 py-3 font-body-md text-on-surface focus:outline-none focus:bg-background transition-colors border border-transparent focus:border-primary"
              >
                <option value="">Pilih Kategori</option>
                {categories?.map((cat) => (
                  <option value={cat.id}>{cat.name}</option>
                ))}
              </select>
            </div>
          </div>
        </div>

        <!-- Descriptions -->
        <div class="space-y-6">
          <h2 class="font-headline-sm text-on-surface pb-2 border-b border-surface-container-highest">
            Deskripsi
          </h2>

          <div class="space-y-2">
            <label for="short_description" class="font-label-sm uppercase text-on-surface block">
              Deskripsi Singkat
            </label>
            <textarea
              id="short_description"
              name="short_description"
              rows="2"
              class="w-full bg-surface-container-low px-4 py-3 font-body-md text-on-surface focus:outline-none focus:bg-background transition-colors border border-transparent focus:border-primary resize-none"
              placeholder="Deskripsi singkat 1-2 kalimat"
            ></textarea>
          </div>

          <div class="space-y-2">
            <label for="description" class="font-label-sm uppercase text-on-surface block">
              Deskripsi Lengkap
            </label>
            <textarea
              id="description"
              name="description"
              rows="6"
              class="w-full bg-surface-container-low px-4 py-3 font-body-md text-on-surface focus:outline-none focus:bg-background transition-colors border border-transparent focus:border-primary resize-none"
              placeholder="Deskripsi detail tentang produk"
            ></textarea>
          </div>
        </div>

        <!-- Price & Specs -->
        <div class="space-y-6">
          <h2 class="font-headline-sm text-on-surface pb-2 border-b border-surface-container-highest">
            Harga & Spesifikasi
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="price" class="font-label-sm uppercase text-on-surface block">
                Harga (Rp)
              </label>
              <input
                type="number"
                id="price"
                name="price"
                min="0"
                step="1000"
                class="w-full bg-surface-container-low px-4 py-3 font-body-md text-on-surface focus:outline-none focus:bg-background transition-colors border border-transparent focus:border-primary"
                placeholder="0"
              />
            </div>

            <div class="space-y-2">
              <label class="font-label-sm uppercase text-on-surface block">
                Tampilkan Harga?
              </label>
              <div class="flex items-center gap-4 pt-2">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="show_price" value="true" checked class="w-4 h-4" />
                  <span class="font-body-md text-on-surface">Ya</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="show_price" value="false" class="w-4 h-4" />
                  <span class="font-body-md text-on-surface">Tidak</span>
                </label>
              </div>
            </div>

            <div class="space-y-2">
              <label for="material" class="font-label-sm uppercase text-on-surface block">
                Material
              </label>
              <input
                type="text"
                id="material"
                name="material"
                class="w-full bg-surface-container-low px-4 py-3 font-body-md text-on-surface focus:outline-none focus:bg-background transition-colors border border-transparent focus:border-primary"
                placeholder="Contoh: Kayu Jati Solid"
              />
            </div>

            <div class="space-y-2">
              <label for="finish" class="font-label-sm uppercase text-on-surface block">
                Finishing / Warna
              </label>
              <input
                type="text"
                id="finish"
                name="finish"
                class="w-full bg-surface-container-low px-4 py-3 font-body-md text-on-surface focus:outline-none focus:bg-background transition-colors border border-transparent focus:border-primary"
                placeholder="Contoh: Natural Oil Matte"
              />
            </div>

            <div class="space-y-2 md:col-span-2">
              <label for="dimensions" class="font-label-sm uppercase text-on-surface block">
                Dimensi
              </label>
              <input
                type="text"
                id="dimensions"
                name="dimensions"
                class="w-full bg-surface-container-low px-4 py-3 font-body-md text-on-surface focus:outline-none focus:bg-background transition-colors border border-transparent focus:border-primary"
                placeholder="Contoh: P 45 cm × L 50 cm × T 85 cm"
              />
            </div>
          </div>
        </div>

        <!-- Images -->
        <div class="space-y-6">
          <h2 class="font-headline-sm text-on-surface pb-2 border-b border-surface-container-highest">
            Gambar Produk
          </h2>

          <div class="space-y-2">
            <label for="main_image_file" class="font-label-sm uppercase text-on-surface block">
              Upload Gambar Utama <span class="text-error">*</span>
            </label>
            <input
              type="file"
              id="main_image_file"
              name="main_image_file"
              accept="image/jpeg,image/jpg,image/png,image/webp"
              class="w-full bg-surface-container-low px-4 py-3 font-body-md text-on-surface focus:outline-none focus:bg-background transition-colors border border-transparent focus:border-primary file:mr-4 file:py-2 file:px-4 file:border-0 file:font-label-sm file:uppercase file:bg-primary file:text-on-primary file:cursor-pointer hover:file:bg-secondary"
            />
            <p class="font-body-sm text-on-surface-variant">
              Format: JPG, PNG, WebP. Maksimal 5MB.
            </p>
            <div id="main-image-preview" class="hidden mt-4">
              <img src="" alt="Preview" class="w-48 h-48 object-cover border border-surface-container-highest" />
            </div>
          </div>

          <div class="border-t border-surface-container-highest pt-6">
            <p class="font-label-sm uppercase text-on-surface-variant mb-2">Atau gunakan URL</p>
            <input
              type="url"
              id="main_image_url"
              name="main_image_url"
              class="w-full bg-surface-container-low px-4 py-3 font-body-md text-on-surface focus:outline-none focus:bg-background transition-colors border border-transparent focus:border-primary"
              placeholder="https://images.unsplash.com/..."
            />
          </div>

          <input type="hidden" id="main_image" name="main_image" />

          <!-- Gallery Images -->
          <div class="border-t border-surface-container-highest pt-6 space-y-4">
            <div class="space-y-2">
              <label for="gallery_files" class="font-label-sm uppercase text-on-surface block">
                Gambar Tambahan (Opsional)
              </label>
              <input
                type="file"
                id="gallery_files"
                name="gallery_files"
                accept="image/jpeg,image/jpg,image/png,image/webp"
                multiple
                class="w-full bg-surface-container-low px-4 py-3 font-body-md text-on-surface focus:outline-none focus:bg-background transition-colors border border-transparent focus:border-primary file:mr-4 file:py-2 file:px-4 file:border-0 file:font-label-sm file:uppercase file:bg-primary file:text-on-primary file:cursor-pointer hover:file:bg-secondary"
              />
              <p class="font-body-sm text-on-surface-variant">
                Pilih beberapa gambar sekaligus. Format JPG, PNG, atau WebP, maksimal 5 MB per gambar.
              </p>
            </div>

            <!-- Gallery Preview -->
            <div id="gallery-preview" class="hidden">
              <p class="font-label-sm uppercase text-on-surface mb-2">Preview Gambar Tambahan:</p>
              <div id="gallery-preview-container" class="grid grid-cols-2 md:grid-cols-4 gap-4"></div>
            </div>
          </div>
        </div>

        <!-- Status -->
        <div class="space-y-6">
          <h2 class="font-headline-sm text-on-surface pb-2 border-b border-surface-container-highest">
            Status Publikasi
          </h2>

          <div class="space-y-2">
            <label class="font-label-sm uppercase text-on-surface block">
              Status <span class="text-error">*</span>
            </label>
            <div class="flex items-center gap-4">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="status" value="draft" checked class="w-4 h-4" />
                <span class="font-body-md text-on-surface">Draft</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="status" value="published" class="w-4 h-4" />
                <span class="font-body-md text-on-surface">Published</span>
              </label>
            </div>
            <p class="font-body-sm text-on-surface-variant">
              Draft = tidak tampil di website publik. Published = langsung tampil.
            </p>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4 pt-6 border-t border-surface-container-highest">
          <button
            type="submit"
            id="submit-button"
            class="inline-flex items-center gap-2 bg-primary text-on-primary px-8 py-3 font-label-md uppercase hover:bg-secondary transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span class="material-symbols-outlined text-[18px]">save</span>
            <span id="submit-text">Simpan Produk</span>
          </button>
          <a
            href="/admin/products"
            class="inline-flex items-center gap-2 border border-outline px-8 py-3 font-label-md uppercase text-on-surface hover:bg-surface-container transition-colors"
          >
            Batal
          </a>
        </div>

        <div id="form-message" class="hidden">
          <p class="px-4 py-3 font-body-md"></p>
        </div>
      </form>
    </div>
  </div>

  <!-- Load Supabase client for product creation -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <script is:inline define:vars={{
    supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL,
    supabaseKey: import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY
  }}>
    // Initialize variables
    let selectedGalleryFiles = [];
    let slugManuallyEdited = false;
    let isSubmitting = false;

    // Wait for DOM to be ready
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('product-form');
      const messageDiv = document.getElementById('form-message');
      const nameInput = document.getElementById('name');
      const slugInput = document.getElementById('slug');
      const productCodeInput = document.getElementById('product_code');
      const mainImageFileInput = document.getElementById('main_image_file');
      const mainImageUrlInput = document.getElementById('main_image_url');
      const mainImagePreview = document.getElementById('main-image-preview');
      const galleryFilesInput = document.getElementById('gallery_files');
      const galleryPreview = document.getElementById('gallery-preview');
      const galleryPreviewContainer = document.getElementById('gallery-preview-container');
      const submitButton = document.getElementById('submit-button');
      const submitText = document.getElementById('submit-text');

      // Initialize Supabase client
      const { createClient } = supabase;
      const supabaseClient = createClient(supabaseUrl, supabaseKey);

      console.log('Form script initialized');

      // Auto-generate slug from name
      if (nameInput && slugInput) {
        nameInput.addEventListener('input', () => {
          if (!slugManuallyEdited) {
            const slug = nameInput.value
              .toLowerCase()
              .trim()
              .replace(/[^\w\s-]/g, '')
              .replace(/\s+/g, '-')
              .replace(/-+/g, '-')
              .replace(/^-+|-+$/g, '');

            slugInput.value = slug;
            console.log('Auto-generated slug:', slug);
          }
        });

        // Mark slug as manually edited if user changes it
        slugInput.addEventListener('input', () => {
          slugManuallyEdited = true;
          console.log('Slug manually edited');
        });

        // Reset slugManuallyEdited when slug is cleared
        slugInput.addEventListener('change', () => {
          if (!slugInput.value || slugInput.value.trim() === '') {
            slugManuallyEdited = false;
            console.log('Slug cleared, auto-generation enabled');
          }
        });
      }

      // Image validation function
      function validateImageFile(file) {
        const maxSize = 5 * 1024 * 1024; // 5MB
        const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];

        if (!allowedTypes.includes(file.type)) {
          return { valid: false, error: 'Format file tidak didukung. Gunakan JPG, PNG, atau WebP.' };
        }

        if (file.size > maxSize) {
          return { valid: false, error: 'Ukuran file terlalu besar. Maksimal 5MB.' };
        }

        return { valid: true };
      }

      // Preview main image
      if (mainImageFileInput && mainImagePreview) {
        mainImageFileInput.addEventListener('change', (e) => {
          const file = e.target.files?.[0];
          if (file) {
            const validation = validateImageFile(file);
            if (!validation.valid) {
              alert(validation.error);
              mainImageFileInput.value = '';
              return;
            }

            const reader = new FileReader();
            reader.onload = (e) => {
              const img = mainImagePreview.querySelector('img');
              if (img && e.target?.result) {
                img.src = e.target.result;
                mainImagePreview.classList.remove('hidden');
              }
            };
            reader.readAsDataURL(file);
          }
        });
      }

      // Preview gallery images
      if (galleryFilesInput && galleryPreviewContainer) {
        galleryFilesInput.addEventListener('change', (e) => {
          const files = Array.from(e.target.files || []);

          if (files.length === 0) return;

          const invalidFiles = [];
          const validFiles = [];

          files.forEach(file => {
            const validation = validateImageFile(file);
            if (!validation.valid) {
              invalidFiles.push(`${file.name}: ${validation.error}`);
            } else {
              validFiles.push(file);
            }
          });

          if (invalidFiles.length > 0) {
            alert('Beberapa file tidak valid:\n' + invalidFiles.join('\n'));
          }

          if (validFiles.length === 0) {
            galleryFilesInput.value = '';
            return;
          }

          selectedGalleryFiles = validFiles;
          renderGalleryPreviews();
        });
      }

      function renderGalleryPreviews() {
        if (!galleryPreviewContainer) return;

        galleryPreviewContainer.innerHTML = '';

        if (selectedGalleryFiles.length === 0) {
          if (galleryPreview) galleryPreview.classList.add('hidden');
          return;
        }

        if (galleryPreview) galleryPreview.classList.remove('hidden');

        selectedGalleryFiles.forEach((file, index) => {
          const reader = new FileReader();
          reader.onload = (e) => {
            const container = document.createElement('div');
            container.className = 'relative group';

            const img = document.createElement('img');
            img.src = e.target.result;
            img.alt = file.name;
            img.className = 'w-full h-32 object-cover border border-surface-container-highest';

            const removeBtn = document.createElement('button');
            removeBtn.type = 'button';
            removeBtn.className = 'absolute top-2 right-2 bg-error text-on-primary w-8 h-8 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity';
            removeBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">close</span>';
            removeBtn.onclick = () => removeGalleryImage(index);

            const fileName = document.createElement('p');
            fileName.className = 'font-body-sm text-on-surface-variant mt-1 truncate';
            fileName.textContent = file.name;

            container.appendChild(img);
            container.appendChild(removeBtn);
            container.appendChild(fileName);
            galleryPreviewContainer.appendChild(container);
          };
          reader.readAsDataURL(file);
        });
      }

      function removeGalleryImage(index) {
        selectedGalleryFiles.splice(index, 1);
        renderGalleryPreviews();

        if (galleryFilesInput) {
          galleryFilesInput.value = '';
        }
      }

      function showMessage(text, isError = false) {
        if (messageDiv) {
          messageDiv.classList.remove('hidden');
          const p = messageDiv.querySelector('p');
          if (p) {
            p.textContent = text;
            if (isError) {
              p.style.backgroundColor = '#ffdad6';
              p.style.color = '#ba1a1a';
            } else {
              p.style.backgroundColor = '#d4c4b6';
              p.style.color = '#1c1c18';
            }
          }
        }
      }

      function setSubmitState(submitting, text) {
        isSubmitting = submitting;
        if (submitButton) {
          submitButton.disabled = submitting;
        }
        if (submitText && text) {
          submitText.textContent = text;
        }
      }

      // Upload image function
      async function uploadProductImage(file, productCode) {
        const timestamp = Date.now();
        const fileExt = file.name.split('.').pop();
        const fileName = `${productCode}-${timestamp}.${fileExt}`;
        const filePath = `products/${fileName}`;

        const { error } = await supabaseClient.storage
          .from('product-images')
          .upload(filePath, file, {
            cacheControl: '3600',
            upsert: false
          });

        if (error) {
          console.error('Upload error:', error);
          throw new Error('Gagal mengunggah gambar: ' + error.message);
        }

        const { data: { publicUrl } } = supabaseClient.storage
          .from('product-images')
          .getPublicUrl(filePath);

        return publicUrl;
      }

      // Form submit handler
      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();

          if (isSubmitting) {
            console.log('Form already submitting, ignoring duplicate submission');
            return;
          }

          console.log('Form submitted');

          const formData = new FormData(form);
          const mainImageFile = mainImageFileInput?.files?.[0];
          const mainImageUrl = mainImageUrlInput?.value?.trim();
          const productCode = productCodeInput?.value?.trim();
          const slug = slugInput?.value?.trim();
          const categoryId = formData.get('category_id');

          // Validate required fields
          if (!productCode) {
            alert('ID Produk wajib diisi.');
            return;
          }

          if (!slug) {
            alert('URL Slug wajib diisi.');
            return;
          }

          if (!categoryId) {
            alert('Kategori wajib dipilih.');
            return;
          }

          // Validate main image
          if (!mainImageFile && !mainImageUrl) {
            alert('Gambar utama wajib diisi. Upload file atau masukkan URL.');
            return;
          }

          setSubmitState(true, 'Menyimpan...');

          try {
            showMessage('Memproses gambar...');

            // Upload main image if file is provided
            let finalMainImageUrl = mainImageUrl;
            if (mainImageFile) {
              showMessage('Mengunggah gambar utama...');
              finalMainImageUrl = await uploadProductImage(mainImageFile, productCode);
              console.log('Main image uploaded:', finalMainImageUrl);
            }

            if (!finalMainImageUrl) {
              throw new Error('Gambar utama harus diisi');
            }

            // Upload gallery images
            const galleryUrls = [];
            if (selectedGalleryFiles.length > 0) {
              for (let i = 0; i < selectedGalleryFiles.length; i++) {
                const file = selectedGalleryFiles[i];
                showMessage(`Mengunggah gambar tambahan ${i + 1}/${selectedGalleryFiles.length}...`);
                try {
                  const url = await uploadProductImage(file, productCode);
                  galleryUrls.push(url);
                  console.log(`Gallery image ${i + 1} uploaded:`, url);
                } catch (error) {
                  console.error(`Failed to upload gallery image ${i + 1}:`, error);
                }
              }
            }

            showMessage('Menyimpan produk...');

            const productData = {
              name: formData.get('name'),
              product_code: productCode,
              slug: slug,
              category_id: categoryId,
              short_description: formData.get('short_description') || null,
              description: formData.get('description') || null,
              price: formData.get('price') ? parseFloat(formData.get('price')) : null,
              show_price: formData.get('show_price') === 'true',
              material: formData.get('material') || null,
              finish: formData.get('finish') || null,
              dimensions: formData.get('dimensions') || null,
              main_image: finalMainImageUrl,
              gallery: galleryUrls.length > 0 ? galleryUrls : null,
              status: formData.get('status') || 'draft',
            };

            console.log('Saving product to Supabase:', productData);

            const { data, error } = await supabaseClient
              .from('products')
              .insert([productData])
              .select()
              .single();

            if (error) {
              console.error('Supabase error:', error);
              throw error;
            }

            console.log('Product saved successfully:', data);
            showMessage('Produk berhasil disimpan!');

            setTimeout(() => {
              window.location.href = '/admin/products';
            }, 1000);
          } catch (error) {
            console.error('Error saving product:', error);

            let errorMessage = 'Gagal menyimpan produk. ';

            if (error.code === '23505') {
              if (error.message && error.message.includes('slug')) {
                errorMessage += 'URL Slug sudah digunakan produk lain. Silakan gunakan slug berbeda.';
              } else if (error.message && error.message.includes('product_code')) {
                errorMessage += 'ID Produk sudah digunakan produk lain. Silakan gunakan ID berbeda.';
              } else {
                errorMessage += 'Data sudah ada dalam database.';
              }
            } else if (error.code === '23503') {
              errorMessage += 'Kategori tidak valid. Silakan pilih kategori yang tersedia.';
            } else if (error.code === 'PGRST116') {
              errorMessage += 'Tidak memiliki izin untuk menambah produk. Pastikan Anda sudah login sebagai admin.';
            } else if (error.message) {
              errorMessage += error.message;
            } else {
              errorMessage += 'Silakan coba lagi.';
            }

            showMessage(errorMessage, true);
            setSubmitState(false, 'Simpan Produk');
          }
        });
      }
    });
  </script>
</AdminLayout>
