---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'AZKA MEUBEL | Furnitur Berkualitas Indonesia',
  description = 'Koleksi furnitur minimalis berkualitas dengan desain fungsional. Dibuat dengan keahlian tangan dan material terpilih.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <Header />
    <main class="w-full pt-14 md:pt-20 bg-background min-h-screen">
      <slot />
    </main>
    <Footer />
  </body>
</html>
